# log-alert.service + log-alert.timer — runs monitor_logs.sh every hour.
#
# Closes #8
#
# WHY a timer instead of sleep in a loop?
#   The naive approach is: while true; do run_monitor; sleep 3600; done
#   The systemd way is a .timer unit that triggers a .service unit.
#
#   Advantages of the timer approach:
#   - survives reboots without stale processes
#   - you can see exactly when it last ran and when it runs next
#   - systemctl status shows clean state
#   - journalctl captures every run's output separately
#
# This file is the SERVICE — it defines what to run.
# The .timer file (same name, .timer extension) defines WHEN to run it.
# systemd links them by matching filename.

[Unit]
Description=Application log monitor — scans nginx logs and alerts on errors
# After=network.target means wait until the network stack is up
After=network.target

[Service]
# Type=oneshot → the service runs the command once and then exits.
# This is correct for scheduled tasks that aren't long-running daemons.
# systemd marks the service as "inactive" between timer fires, which is expected.
Type=oneshot

ExecStart=/bin/bash /opt/provisioner/scripts/common/monitor_logs.sh

# RemainAfterExit=yes → systemd considers the service "active" even after
# the command exits. Useful for oneshot services so status shows correctly.
RemainAfterExit=no

User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=log-alert

[Install]
# For timer-triggered services, WantedBy points to the timer, not multi-user.target
WantedBy=multi-user.target